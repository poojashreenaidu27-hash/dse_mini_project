# CampusFix Environment Configuration Example
# Copy this file to .env and adjust variables as needed for local development.

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Security & Secrets (Change in production!)
SECRET_KEY=dev-campusfix-insecure-secret-key-change-in-production-min32chars!
SESSION_COOKIE_NAME=campusfix_session
SESSION_MAX_AGE_SECONDS=86400
SECURE_COOKIES=False
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (Persistent SQLite for local dev)
DATABASE_URL=sqlite:///./campusfix.db

# Machine Learning Artifacts
MODEL_STORAGE_PATH=./models/resolution_estimator.joblib
MODEL_METADATA_PATH=./models/model_metadata.json

# Demo Account Credentials (Development only)
DEMO_ADMIN_NAME=Campus Maintenance Lead
DEMO_ADMIN_EMAIL=admin@campusfix.local
DEMO_ADMIN_PASSWORD=AdminCampusFix2026!

DEMO_ANALYST_NAME=Project Reviewer
DEMO_ANALYST_EMAIL=analyst@campusfix.local
DEMO_ANALYST_PASSWORD=AnalystCampusFix2026!

DEMO_USER_NAME=Alex Student
DEMO_USER_EMAIL=student@campusfix.local
DEMO_USER_PASSWORD=StudentCampusFix2026!

